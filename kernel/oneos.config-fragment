# OneOS kernel config fragment.
#
# This is a FRAGMENT, not a full .config. It is merged onto Debian's kernel
# config with scripts/kconfig/merge_config.sh (see README.md in this directory).
# Starting from Debian's config rather than defconfig is deliberate: Debian's
# config already covers the hardware breadth of real consumer laptops, which is
# exactly the thing that kills small distros.
#
# Rationale for every option below is in docs/ARCHITECTURE.md section 1.3.

# =============================================================================
# Android compatibility (Waydroid) -- docs/ARCHITECTURE.md section 4
# =============================================================================
# binderfs is upstream; out-of-tree anbox-modules are NOT needed on 6.x.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# LXC container requirements for the Waydroid container.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y

# =============================================================================
# Windows compatibility (Wine/Proton) -- docs/ARCHITECTURE.md section 3
# =============================================================================
# ntsync provides in-kernel NT synchronization primitives and is a large,
# measurable win over the older esync/fsync approaches.
#
# NOTE: ntsync landed upstream in 6.14. The 6.12 LTS we are targeting does NOT
# have it, so this option requires the backport patch in kernel/patches/.
# If you are building against 6.12 without that patch applied, this line is a
# no-op and the build will silently lack ntsync. Verify after build with:
#   zgrep NTSYNC /proc/config.gz   (or check /dev/ntsync exists at runtime)
CONFIG_NTSYNC=y

# futex_waitv: used by Wine's fsync path and by DXVK. Present since 5.16.
CONFIG_FUTEX=y

# =============================================================================
# Desktop responsiveness on the 4 GB minimum-spec target
# =============================================================================
# Pressure Stall Information -- required for any credible low-memory handling.
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

# zram with zstd. See build/config/includes.chroot/etc/default/zramswap.
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y

# Multi-Gen LRU: materially better page reclaim behaviour under memory
# pressure, which is precisely the 4 GB machine's failure mode.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Full preemption for a responsive desktop under load.
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# =============================================================================
# Filesystems and portals
# =============================================================================
CONFIG_FUSE_FS=y                # Flatpak, AppImage, xdg-desktop-portal
CONFIG_OVERLAY_FS=y             # Flatpak, containers, live ISO
CONFIG_SQUASHFS=y               # live ISO
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_LOOP=y

# =============================================================================
# Security -- docs/ARCHITECTURE.md section 7.2
# =============================================================================
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"

# Landlock: unprivileged sandboxing. Used by the Wine prefix sandbox in Phase 4.
CONFIG_SECURITY_LANDLOCK=y

# seccomp: required by bubblewrap and Flatpak.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Module signing. The key is generated at build time and discarded; only
# in-tree modules built in the same run are loadable. Pairs with lockdown.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
# NOTE: MODULE_SIG_FORCE is deliberately NOT set until Phase 6. Turning it on
# before Secure Boot is in place only breaks out-of-tree driver debugging on the
# test laptops with no security benefit.
# CONFIG_MODULE_SIG_FORCE is not set

# Kernel lockdown, armed in Phase 6 alongside Secure Boot.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y

# Disk encryption (LUKS2 + TPM2), Phase 6.
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y

# Hardening defaults.
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# =============================================================================
# Diagnostics -- keep BTF, you will want eBPF tooling later
# =============================================================================
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_SYSCALL=y
CONFIG_KPROBES=y
