# Force LF line endings on everything that Linux executes or parses.
#
# Without this, Git on Windows checks these files out with CRLF, and a shell
# script whose shebang ends in \r fails on Linux with the famously unhelpful
# "bad interpreter: No such file or directory". The CI build would break, and
# so would anything inside the chroot.

* text=auto eol=lf

*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.list.chroot   text eol=lf
*.hook.chroot   text eol=lf
*.hook.binary   text eol=lf
*.config-fragment text eol=lf
*.patch         text eol=lf
VERSION         text eol=lf
build/auto/*    text eol=lf

# Windows-side script: keep CRLF, PowerShell is happier with it.
*.ps1           text eol=crlf

# Binary artifacts must never be touched.
*.iso           binary
*.img           binary
*.squashfs      binary
*.deb           binary
*.png           binary
*.jpg           binary
