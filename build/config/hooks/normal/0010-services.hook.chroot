#!/bin/sh
# Runs inside the chroot during `lb build`, after packages are installed.
# Enables the services OneOS needs on first boot and applies base policy.

set -e

echo "I: [oneos] configuring services"

# --- Services that must be on at boot ----------------------------------------
systemctl enable systemd-timesyncd.service
# DNS is left to NetworkManager, which writes /etc/resolv.conf itself.
#
# The previous attempt enabled systemd-resolved and pointed /etc/resolv.conf at
# its stub. That made things worse: it overrode NetworkManager's own handling,
# and whenever resolved was not actually running the symlink dangled and name
# resolution stopped completely -- the machine reported "Connected" and could
# not reach a single hostname.
#
# Two components both trying to own one file is the bug. One owner, fewer ways
# to fail.
systemctl disable systemd-resolved.service 2>/dev/null || true
systemctl enable NetworkManager.service

# DO NOT delete /etc/resolv.conf here. An earlier version did, and it was the
# single most damaging line in this repository: live-build puts a working
# resolv.conf in the chroot for the duration of the build and removes it
# afterwards, so deleting it in this hook -- the first one to run -- left every
# later hook without DNS. Waydroid, VLC, Notepad++, F-Droid and 32-bit Wine all
# failed to download, and each reported its own unrelated-looking warning, so
# the image shipped missing five features for one reason.
#
# Nothing needs to be done about resolv.conf at all: live-build cleans up its
# build-time copy, and NetworkManager writes the real one at boot.
systemctl enable bluetooth.service

# fwupd.service is D-Bus activated and has no [Install] section, so enabling it
# is a no-op that only emits "unit files have no installation config". What
# actually needs enabling is the timer that refreshes LVFS metadata; without it
# the system never learns that firmware updates exist.
systemctl enable fwupd-refresh.timer

# zram swap. See /etc/default/zramswap for the sizing rationale.
systemctl enable zramswap.service

# --- Services we deliberately do NOT want -------------------------------------
# No SSH server on a desktop image. If it is installed as a dependency, make
# sure it is not listening by default.
systemctl disable ssh.service 2>/dev/null || true

# --- Boot behaviour ----------------------------------------------------------
# Boot into the graphical session. SDDM starts the Plasma Wayland session --
# Wayland, not X11, because Waydroid cannot work without it.
systemctl set-default graphical.target
systemctl enable sddm.service

# --- Base policy -------------------------------------------------------------
# Members of 'sudo' get admin rights; the live user is added to it by
# live-config. Require a password -- passwordless sudo on a consumer OS is
# indefensible even at this stage.
cat > /etc/sudoers.d/oneos <<'EOF'
%sudo ALL=(ALL:ALL) ALL
EOF
chmod 0440 /etc/sudoers.d/oneos

# Reload sysctl settings shipped in /etc/sysctl.d/90-oneos.conf so they are
# baked into the image state where applicable.
echo "I: [oneos] service configuration complete"
