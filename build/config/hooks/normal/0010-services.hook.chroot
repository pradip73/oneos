#!/bin/sh
# Runs inside the chroot during `lb build`, after packages are installed.
# Enables the services OneOS needs on first boot and applies base policy.

set -e

echo "I: [oneos] configuring services"

# --- Services that must be on at boot ----------------------------------------
systemctl enable systemd-timesyncd.service
systemctl enable systemd-resolved.service
systemctl enable NetworkManager.service
systemctl enable bluetooth.service

# fwupd.service is D-Bus activated and has no [Install] section, so enabling it
# is a no-op that only emits "unit files have no installation config". What
# actually needs enabling is the timer that refreshes LVFS metadata; without it
# the system never learns that firmware updates exist.
systemctl enable fwupd-refresh.timer

# zram swap. See /etc/default/zramswap for the sizing rationale.
systemctl enable zramswap.service

# --- Services we deliberately do NOT want -------------------------------------
# No SSH server on a desktop image. If it is installed as a dependency, make
# sure it is not listening by default.
systemctl disable ssh.service 2>/dev/null || true

# --- Boot behaviour ----------------------------------------------------------
# Phase 1 has no desktop, so boot to a text console. This changes to
# graphical.target in Phase 2 once the compositor exists.
systemctl set-default multi-user.target

# --- Base policy -------------------------------------------------------------
# Members of 'sudo' get admin rights; the live user is added to it by
# live-config. Require a password -- passwordless sudo on a consumer OS is
# indefensible even at this stage.
cat > /etc/sudoers.d/oneos <<'EOF'
%sudo ALL=(ALL:ALL) ALL
EOF
chmod 0440 /etc/sudoers.d/oneos

# Reload sysctl settings shipped in /etc/sysctl.d/90-oneos.conf so they are
# baked into the image state where applicable.
echo "I: [oneos] service configuration complete"
