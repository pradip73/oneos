#!/bin/sh
# Registers the OneOS file handlers shipped in includes.chroot.
#
# Two things have to happen for a double-click to reach our scripts, and both
# are easy to forget because nothing fails loudly when they are missing -- the
# file just opens with the wrong thing, or with nothing.

set -e

echo "I: [oneos] registering file handlers"

# 1. Execute permission. Git tracks the mode, but it does not survive every
#    path a file can take into an image, and a handler that is not executable
#    fails silently with "could not launch".
# Maintaining this list by hand already cost one bug: oneos-run-bundled was
# added and not listed, so VLC failed at the click with "missing executable
# permissions". Glob instead, so a new helper cannot be forgotten.
found=0
for helper in /usr/bin/oneos-*; do
	[ -f "$helper" ] || continue
	chmod 0755 "$helper"
	found=$((found + 1))
done
echo "I: [oneos] made ${found} helper(s) executable"
[ "$found" -gt 0 ] || echo "W: [oneos] no /usr/bin/oneos-* helpers found at all" >&2

# 2. The desktop database. Until it is rebuilt, the MimeType= lines in our
#    .desktop files are invisible to the file manager.
if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database /usr/share/applications || true
fi
if command -v update-mime-database >/dev/null 2>&1; then
	update-mime-database /usr/share/mime || true
fi

echo "I: [oneos] file handlers registered"

# --- OneOS Plasma applets ----------------------------------------------------
# A plasmoid that fails to parse simply does not appear, with the reason only
# in the session log -- so check it here, where the build output is read.
for applet in launcher taskbar quicksettings controlpanel; do
	dir="/usr/share/plasma/plasmoids/org.oneos.${applet}"
	if [ -d "$dir" ]; then
		if command -v qmllint6 >/dev/null 2>&1; then
			qmllint6 "${dir}/contents/ui/main.qml" \
				|| echo "W: [oneos] ${applet} QML has warnings (may still load)" >&2
		fi
		echo "I: [oneos] OneOS ${applet} applet installed"
	else
		echo "W: [oneos] OneOS ${applet} applet missing" >&2
	fi
done
