#!/bin/sh
# Experimental macOS support, via Darling.
#
# WHAT THIS IS
# Darling is to macOS what Wine is to Windows: a translation layer, not an
# emulator and not a copy of macOS. It reimplements Darwin's syscalls, Mach IPC
# and Apple's frameworks on top of Linux, using Apple's own open-source releases
# for the lowest layers.
#
# WHAT IT HONESTLY DOES AND DOES NOT DO
# Command-line macOS software works. GUI support is, in the project's own
# words, "in active development" -- an AppKit built on Cocotron and an early
# Metal-over-Vulkan backend. The applications people actually want a Mac for --
# Photoshop, Final Cut, Xcode, Logic -- do not run, and will not for a long
# time. Anything OneOS says about this must lead with that.
#
# WHY IT IS SAFE TO ATTEMPT
# Modern Darling needs no kernel module: it runs entirely in userspace through
# darlingserver. So this cannot affect boot, and a failure here costs nothing
# but macOS support.
#
# WHY THE PACKAGES ARE A RISK
# The project publishes .deb files built for Ubuntu noble, not Debian trixie.
# They may simply install, or their dependencies may not resolve. apt is asked
# to work it out and the whole step is non-fatal either way.

set -e

readonly REL="v0.1.20260608"
readonly ZIP="debs_20260608.zip"
readonly URL="https://github.com/darlinghq/darling/releases/download/${REL}/${ZIP}"
# The project's own hello-world package, referenced from their README. A
# command-line program, because that is the honest demonstration of what this
# layer can currently do.
readonly DEMO_PKG="https://darling-misc.s3.eu-central-1.amazonaws.com/mc-4.8.7-0.pkg"
readonly STAGE="/usr/share/oneos/mac"

echo "I: [oneos] attempting experimental macOS support (Darling)"

mkdir -p "$STAGE"
tmp=$(mktemp -d)

if ! curl -fsSL --retry 3 --max-time 600 -o "$tmp/darling.zip" "$URL"; then
	echo "W: [oneos] could not fetch Darling -- no macOS support in this image" >&2
	rm -rf "$tmp"; exit 0
fi

if ! unzip -q "$tmp/darling.zip" -d "$tmp/x"; then
	echo "W: [oneos] Darling archive could not be unpacked -- no macOS support" >&2
	rm -rf "$tmp"; exit 0
fi

# apt rather than dpkg -i, so dependencies resolve instead of leaving a
# half-configured system.
#
# WHY THE SECOND ATTEMPT EXISTS
# The first build asked apt for every .deb at once and got back:
#
#     darling-gui:amd64 Depends libavcodec60 (>= 7:6.0)
#
# That is the entire incompatibility. Ubuntu noble carries libavcodec60;
# trixie moved to libavcodec61 with ffmpeg 7.1. One package, one soname.
#
# And it is darling-gui -- the component this hook already says does not
# usefully work, because Darling's graphical support is unfinished. So
# dropping it costs nothing that was ever promised, and the command-line
# support that WAS promised has no such dependency.
#
# AND WHY GUESSING STOPPED
# Dropping darling-gui was not enough -- `darling` hard-depends on it -- and
# dropping `darling` too was not enough either, because `darling-extra`
# depends on `darling`. Each build bought exactly one edge of the dependency
# graph, which is a slow way to learn a graph.
#
# So this no longer guesses. It reads every package's own Depends field, marks
# darling-gui as unavailable, and repeatedly marks anything that depends on
# something already marked -- the transitive closure of "needs the GUI". What
# is left is, by construction, the largest part of Darling that can be
# installed on trixie: the command-line runtime, which is exactly and only
# what OneOS claims for macOS.
#
# If the runtime itself turns out to sit under the GUI, nothing installs and
# the check below says so rather than shipping a broken half.
install_set() {
	apt-get install -y --no-install-recommends "$@" 2>"$tmp/apt.err"
}

# package<TAB>file<TAB>depends, once, so the loop below is arithmetic on text
# rather than repeated dpkg calls.
: > "$tmp/table"
for f in $(find "$tmp/x" -name '*.deb' | sort); do
	printf '%s	%s	%s
' 		"$(dpkg-deb -f "$f" Package)" "$f" "$(dpkg-deb -f "$f" Depends)" 		>> "$tmp/table"
done

# libavcodec60 is the root of it: Ubuntu noble has it, trixie moved to 61
# with ffmpeg 7.1, and darling-gui is the only thing that wants it.
excluded="darling-gui"
changed=1
while [ "$changed" -eq 1 ]; do
	changed=0
	while IFS='	' read -r pkg file deps; do
		# Already excluded? Nothing to decide.
		case " $excluded " in *" $pkg "*) continue ;; esac
		for e in $excluded; do
			if printf '%s' "$deps" | grep -qw -- "$e"; then
				excluded="$excluded $pkg"
				changed=1
				break
			fi
		done
	done < "$tmp/table"
done

keep=""
while IFS='	' read -r pkg file deps; do
	case " $excluded " in *" $pkg "*) continue ;; esac
	keep="$keep $file"
done < "$tmp/table"

for e in $excluded; do
	echo "I: [oneos] macOS: leaving out $e (needs the GUI stack)"
done

# The whole archive first, in case an upstream release has fixed this; then
# the GUI-free closure.
if install_set "$tmp"/x/debs_*/*.deb; then
	gui="with the (unfinished) GUI packages"
elif [ -n "$keep" ] && install_set $keep; then
	gui="command line only -- the GUI packages need libavcodec60, trixie has 61"
	echo "W: [oneos] macOS: installed without the GUI stack (expected)" >&2
fi

# apt-get install with an empty argument list exits 0, so a find that matched
# nothing would report success and ship no macOS support at all. Ask for the
# binary rather than trusting the exit code.
if [ -n "${gui:-}" ] && [ -x /usr/bin/darling ]; then
	echo "I: [oneos] Darling installed -- ${gui}"

	# Stage the demo so trying it needs no download and works offline.
	if curl -fsSL --retry 2 --max-time 300 -o "$STAGE/demo.pkg" "$DEMO_PKG"; then
		echo "I: [oneos] macOS demo package staged"
	else
		echo "W: [oneos] could not stage the macOS demo package" >&2
		rm -f "$STAGE/demo.pkg"
	fi
else
	echo "W: [oneos] Darling packages would not install on trixie" >&2
	echo "W: [oneos] (they are built for Ubuntu noble) -- no macOS support" >&2
	# The archive's actual contents. Two builds have now been spent inferring
	# the package layout from apt's complaints one edge at a time; W: rather
	# than I: because annotations are the only channel readable without a
	# repository token, so an I: line is a diagnostic nobody can see.
	find "$tmp/x" -name '*.deb' -printf '%f
' | sort | while IFS= read -r d; do
		echo "W: [oneos] macOS archive has: $d" >&2
	done
	# The unmet-dependency lines, so the next attempt starts from a fact.
	grep -E 'Depends|Conflicts|but it is|not installable|E:' "$tmp/apt.err" 		| sort -u | head -n 12 | while IFS= read -r l; do
			echo "W: [oneos] apt: $l" >&2
		done
	# Leave nothing half-installed behind.
	apt-get -y -f install 2>/dev/null || true
fi

rm -rf "$tmp"
echo "I: [oneos] macOS step complete"
