#!/bin/sh
# Renders the OneOS mark and activates the boot splash.
#
# The logo lives in the repository as a single SVG. Plymouth cannot read SVG,
# so the PNGs it needs are rendered here at build time rather than committed as
# binaries -- one source of truth, and the frames stay in sync with the artwork
# automatically.
#
# Every step degrades rather than failing: a boot splash is not worth losing an
# ISO over. Without the frames the splash is a static mark, and without the mark
# Plymouth falls back to its own default theme.

set -e

readonly SRC=/usr/share/oneos/oneos-mark.svg
readonly DEST=/usr/share/plymouth/themes/oneos
readonly FRAMES=24

echo "I: [oneos] rendering boot splash artwork"

if [ ! -f "$SRC" ]; then
	echo "W: [oneos] $SRC missing -- keeping the default Plymouth theme" >&2
	exit 0
fi

if ! command -v rsvg-convert >/dev/null 2>&1; then
	echo "W: [oneos] rsvg-convert unavailable -- no splash artwork" >&2
	exit 0
fi

# The still mark, used if the animation frames are unusable.
sed -e "s/RING_OFFSET/14/" -e "s/GLYPH_COLOR/#EAF6F3/" "$SRC" > /tmp/oneos-mark.svg
rsvg-convert -w 512 -h 512 -o "$DEST/logo.png" /tmp/oneos-mark.svg || \
	echo "W: [oneos] could not render logo.png" >&2

# Animation frames: the ring gap closing from 82 (fully open) to 14 (closed).
# 24 frames at ~5 refresh ticks each is about 2.5 seconds, which is close to
# the boot time we are aiming for on the target hardware.
i=0
while [ "$i" -lt "$FRAMES" ]; do
	# Integer arithmetic only -- sh has no floats.
	offset=$(( 82 - ( (82 - 14) * i / (FRAMES - 1) ) ))
	sed -e "s/RING_OFFSET/${offset}/" -e "s/GLYPH_COLOR/#EAF6F3/" "$SRC" > /tmp/oneos-frame.svg
	rsvg-convert -w 512 -h 512 -o "${DEST}/ring-${i}.png" /tmp/oneos-frame.svg 2>/dev/null || true
	i=$(( i + 1 ))
done
# The progress rail. Plymouth's script module has no primitive for drawing a
# rectangle, so the bar has to arrive as an image like everything else.
cat > /tmp/oneos-rail.svg <<'RAILSVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 6" width="400" height="24">
  <rect x="0" y="0" width="100" height="6" rx="3" fill="#FFFFFF"/>
</svg>
RAILSVG
rsvg-convert -w 400 -h 24 -o "$DEST/rail.png" /tmp/oneos-rail.svg 2>/dev/null || 	echo "W: [oneos] could not render rail.png -- the slow-boot bar will not appear" >&2

rm -f /tmp/oneos-mark.svg /tmp/oneos-frame.svg /tmp/oneos-rail.svg
echo "I: [oneos] rendered $(ls -1 ${DEST}/ring-*.png 2>/dev/null | wc -l) animation frames"

# --- Activate ----------------------------------------------------------------
# Plymouth picks its theme through the alternatives system on Debian. Setting
# the file alone is not enough; the initramfs has to be rebuilt or the old
# theme keeps showing, which is the classic "I changed it and nothing happened"
# failure here.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
	if plymouth-set-default-theme oneos 2>/dev/null; then
		echo "I: [oneos] boot splash set to oneos"
	else
		echo "W: [oneos] could not set the default theme" >&2
	fi
fi

if command -v update-initramfs >/dev/null 2>&1; then
	update-initramfs -u || echo "W: [oneos] initramfs rebuild failed; splash may not appear" >&2
fi

# --- Wallpaper ---------------------------------------------------------------
# Rendered at build time from SVG for the same reason as the mark: one source
# of truth. Two sizes because Plasma picks the closest match and upscaling a
# 1080p image onto a 4K panel looks obviously cheap.
readonly WALL=/usr/share/wallpapers/OneOS/contents/images
readonly WALLSRC=/usr/share/oneos/oneos-wallpaper.svg
if [ -f "$WALLSRC" ] && command -v rsvg-convert >/dev/null 2>&1; then
	mkdir -p "$WALL"
	rsvg-convert -w 1920 -h 1080 -o "$WALL/1920x1080.png" "$WALLSRC" 2>/dev/null || 		echo "W: [oneos] could not render the 1080p wallpaper" >&2
	rsvg-convert -w 3840 -h 2160 -o "$WALL/3840x2160.png" "$WALLSRC" 2>/dev/null || 		echo "W: [oneos] could not render the 4K wallpaper" >&2
	echo "I: [oneos] wallpaper rendered"
else
	echo "W: [oneos] wallpaper source missing -- Plasma keeps the Debian default" >&2
fi

# --- Installer branding ------------------------------------------------------
# Calamares needs the logo as a PNG too. Rendered from the same SVG so the
# installer and the boot splash can never drift apart.
readonly CAL=/usr/share/calamares/branding/oneos
if [ -d "$CAL" ] && command -v rsvg-convert >/dev/null 2>&1; then
	sed -e "s/RING_OFFSET/14/" -e "s/GLYPH_COLOR/#EAF6F3/" "$SRC" > /tmp/oneos-cal.svg
	rsvg-convert -w 256 -h 256 -o "${CAL}/logo.png" /tmp/oneos-cal.svg 2>/dev/null || \
		echo "W: [oneos] could not render the installer logo" >&2
	rm -f /tmp/oneos-cal.svg
fi

# Point Calamares at our branding. calamares-settings-debian ships a working
# settings.conf; rewriting it wholesale would mean owning every module choice,
# so only the branding line is changed. If the shipped file ever stops naming a
# branding component this quietly does nothing, which is why it is checked.
if [ -f /etc/calamares/settings.conf ]; then
	if grep -q '^branding:' /etc/calamares/settings.conf; then
		sed -i 's/^branding:.*/branding: oneos/' /etc/calamares/settings.conf
		echo "I: [oneos] installer branding set to oneos"
	else
		echo "W: [oneos] settings.conf has no branding line -- installer keeps Debian branding" >&2
	fi
else
	echo "W: [oneos] calamares settings.conf not found" >&2
fi

# --- Installer launcher ------------------------------------------------------
# calamares-settings-debian ships the desktop entry that appears on the live
# desktop, and it says "Install Debian". Changing the branding component inside
# Calamares does not touch it -- so the first thing a user sees on the OneOS
# desktop is an invitation to install a different operating system.
#
# Rewritten in place rather than shipped as our own file, so it keeps whatever
# Exec line and permissions the package uses.
for entry in /usr/share/applications/calamares*.desktop \
             /usr/share/applications/install-debian.desktop; do
	[ -f "$entry" ] || continue
	sed -i \
		-e 's/^Name=.*/Name=Install OneOS/' \
		-e 's/^GenericName=.*/GenericName=System Installer/' \
		-e 's/^Comment=.*/Comment=Install OneOS on this computer/' \
		-e '/^Name\[/d' -e '/^GenericName\[/d' -e '/^Comment\[/d' \
		"$entry"
	echo "I: [oneos] renamed $(basename "$entry")"
done

# live-config copies that entry onto the live desktop at boot, so the icon the
# user actually clicks picks up the rename too.
if command -v update-desktop-database >/dev/null 2>&1; then
	update-desktop-database /usr/share/applications || true
fi
