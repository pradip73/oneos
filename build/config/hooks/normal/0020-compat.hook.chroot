#!/bin/sh
# Runs inside the chroot after the package lists are installed.
#
# Handles the two things a package list cannot express:
#   1. enabling the i386 architecture so 32-bit Windows applications run
#   2. preparing Waydroid without downloading its Android image at build time
#
# Deliberately tolerant: neither of these is worth failing the whole ISO build
# over, so each step reports and continues. A missing wine32 costs 32-bit app
# support; a build that dies costs everything.

set -e

echo "I: [oneos] configuring compatibility layers"

# Everything below this line downloads something. When DNS is broken inside the
# chroot each step fails separately and reports its own symptom -- "no Waydroid
# key", "could not fetch VLC" -- and the shared cause is invisible. Say it once,
# up front, so the next person reads one line instead of five.
if ! curl -fsS --max-time 20 -o /dev/null https://deb.debian.org/ 2>/dev/null; then
	echo "W: [oneos] NO NETWORK IN THE BUILD CHROOT -- every download below will" >&2
	echo "W: [oneos] fail. Windows apps, Android support and the staged APKs will" >&2
	echo "W: [oneos] all be missing from this image for this one reason." >&2
fi

# --- 32-bit Windows applications ---------------------------------------------
# A very large share of Windows software is still 32-bit -- older installers,
# line-of-business apps, and most games from before roughly 2015. 64-bit Wine
# alone cannot run any of it, so this is not an optional extra.
#
# i386 has to be enabled with dpkg before apt can see wine32 at all, which is
# why this cannot live in the package list.
echo "I: [oneos] enabling i386 for 32-bit Wine"
if dpkg --add-architecture i386 && apt-get update -qq; then
	if apt-get install -y --no-install-recommends wine32; then
		echo "I: [oneos] wine32 installed -- 32-bit Windows apps supported"
	else
		echo "W: [oneos] wine32 unavailable; 64-bit Windows apps only" >&2
	fi
else
	echo "W: [oneos] could not enable i386; 64-bit Windows apps only" >&2
fi

# --- Waydroid ----------------------------------------------------------------
# Waydroid is NOT in the Debian archive. It is published from the project's own
# repository, so it is installed here rather than from a package list: if that
# repository is unreachable or has no build for our suite, this degrades to
# "no Android support" instead of failing the entire ISO.
#
# This does add a third-party APT source to the image, which is a real trust
# decision -- whoever controls repo.waydro.id can ship code to OneOS users. It
# is signed, and it is the same source the Waydroid project tells everyone to
# use, but it is worth revisiting before any release that calls itself stable.
echo "I: [oneos] installing Waydroid from its upstream repository"
if curl -fsSL --retry 3 https://repo.waydro.id/waydroid.gpg \
		-o /usr/share/keyrings/waydroid.gpg; then
	# arch=all is not optional, and leaving it out is exactly what broke the
	# first attempt. The repository's Release file advertises
	#     Architectures: i386 amd64 arm64 armhf all
	# but only ever publishes main/binary-all/Packages -- main/binary-amd64 is
	# a 404. apt then fails the entire update, which took the install down with
	# it and left only "Unable to locate package waydroid" with no hint why.
	#
	# Restricting the entry to arch=all makes apt fetch the one index that
	# exists. Nothing is lost: waydroid is Architecture: all, being Python plus
	# a systemd unit.
	echo "deb [arch=all signed-by=/usr/share/keyrings/waydroid.gpg] https://repo.waydro.id/ trixie main" \
		> /etc/apt/sources.list.d/waydroid.list

	if apt-get update -qq && apt-get install -y --no-install-recommends waydroid; then
		# Leave the container DISABLED. It costs 1-1.5 GB of RAM the moment it
		# starts, which the 4 GB target cannot spend before the user has asked
		# for a single Android app. See ARCHITECTURE.md 4.2 point 1.
		systemctl disable waydroid-container.service 2>/dev/null || true
		echo "I: [oneos] waydroid installed, container disabled until first use"
	else
		rm -f /etc/apt/sources.list.d/waydroid.list
		apt-get update -qq || true
		echo "W: [oneos] waydroid package unavailable -- image ships WITHOUT Android support" >&2
	fi
else
	echo "W: [oneos] could not fetch the Waydroid signing key -- no Android support" >&2
fi

# The Android system image is a further ~700 MB and is fetched by
# `waydroid init` on first use. It is deliberately not baked in: it would
# nearly double the ISO, and it is redistributed by the Waydroid project
# rather than by us.

# --- Wine sandbox groundwork -------------------------------------------------
# ARCHITECTURE.md 3.4 treats sandboxing Wine prefixes as mandatory, not
# optional: a .exe from the internet otherwise runs with the user's full
# privileges. bubblewrap is the mechanism; the prefix manager that uses it is
# Phase 4 work and does not exist yet.
#
# Installing the tool now does NOT make anything safe. Until the prefix manager
# ships, Windows applications on OneOS run unsandboxed, and the release notes
# must say so plainly.
apt-get install -y --no-install-recommends bubblewrap || \
	echo "W: [oneos] bubblewrap unavailable" >&2

echo "I: [oneos] compatibility layer configuration complete"
