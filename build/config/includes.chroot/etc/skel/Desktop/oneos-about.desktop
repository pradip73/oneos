[Desktop Entry]
Type=Application
Name=This computer
GenericName=System information
Comment=Drives, memory, and what this machine can run
# The full page: drives on the left, the machine on the right, with an
# "Open drives" button for the file-manager view. Windows opens a plain folder
# here; this answers the second question people actually came with -- what is
# in this thing -- without a second trip.
Exec=plasmawindowed org.oneos.thiscomputer
Icon=computer
Terminal=false
Categories=System;
