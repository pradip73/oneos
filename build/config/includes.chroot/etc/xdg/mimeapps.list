# OneOS default file handlers.
#
# Without these, double-clicking a .exe offers a bare "Open with" list, and a
# .apk does nothing at all -- which is the single most common thing people try
# first on an OS that claims to run Windows and Android software.

[Default Applications]
# Windows programs
application/x-ms-dos-executable=oneos-install-exe.desktop
application/x-msdownload=oneos-install-exe.desktop
application/vnd.microsoft.portable-executable=oneos-install-exe.desktop
application/x-msi=oneos-install-exe.desktop

# Android apps
application/vnd.android.package-archive=oneos-install-apk.desktop

# Linux packages.
#
# These do NOT go to Discover. Discover installs local .deb files only through
# its PackageKit backend, so without PackageKit it opens, shows nothing useful
# and installs nothing -- silently. oneos-install-deb calls apt directly, which
# also resolves dependencies properly.
application/vnd.debian.binary-package=oneos-install-deb.desktop
application/x-deb=oneos-install-deb.desktop
application/x-debian-package=oneos-install-deb.desktop

# Flatpak references are different: Discover handles these natively through the
# flatpak backend, which we do ship.
application/vnd.flatpak=org.kde.discover.desktop
application/vnd.flatpak.ref=org.kde.discover.desktop
