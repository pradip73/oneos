# OneOS desktop defaults: wallpaper and the folder-view containment.
#
# Containment 1 is the desktop itself. Setting org.kde.plasma.folder rather
# than org.kde.plasma.desktop is deliberate -- it is what makes icons on the
# desktop appear at all, which the installed-program shortcuts depend on.

[Containments][1]
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=/usr/share/wallpapers/OneOS/
SlidePaths=/usr/share/wallpapers/

# Panel: use the task manager that shows window TITLES, not Plasma's default
# icons-only one. Someone arriving from Windows reads the taskbar to find a
# window; a row of identical icons makes them hunt.
#
# NOTE: this is the most fragile thing in this file. Plasma rewrites the applet
# layout on first login and may ignore it. If the taskbar comes up icons-only,
# that is this setting losing, not the image being broken -- it can be changed
# by right-clicking the taskbar.
[Containments][2]
plugin=org.kde.panel

[Containments][2][Applets][3]
plugin=org.kde.plasma.taskmanager

[Containments][2][Applets][3][Configuration][General]
showToolTips=true
groupingStrategy=0

# Start menu favourites -- the "Everyday" row from the launcher design, plus
# the two tiles that are the point of this OS. Same fragility as the taskbar
# setting above: Plasma may rewrite the layout on first login.
[Containments][2][Applets][4][Configuration][General]
favorites=firefox-esr.desktop,org.kde.dolphin.desktop,oneos-windows-settings.desktop,oneos-android-settings.desktop,org.kde.konsole.desktop,oneos-control-panel.desktop,oneos-about.desktop
showAppsByName=true
