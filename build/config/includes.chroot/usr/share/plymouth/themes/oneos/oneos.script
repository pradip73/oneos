// OneOS boot splash.
//
// Implements design B: a field of the product's own colour rather than black,
// the mark alone at large size with no wordmark, and a progress rail that
// stays hidden unless boot is actually taking a while.
//
// Plymouth's script module has no loops, no string formatting worth the name,
// and redraws through a callback. Everything below is shaped by that.

// --- The colour field --------------------------------------------------------
// Plymouth only does a vertical gradient, so the radial glow in the mockup is
// approximated top-to-bottom. Values are 0-1 floats, not 0-255.
//   top    #0E8672   bottom #073F38
Window.SetBackgroundTopColor(0.055, 0.525, 0.447);
Window.SetBackgroundBottomColor(0.027, 0.247, 0.220);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

// --- The mark ----------------------------------------------------------------
// ring-NN.png are frames of the glyph with the ring gap progressively closing.
// They are rendered from branding/oneos-mark.svg at build time; if that failed,
// logo.png alone still gives a correct, static splash.
frame_count = 24;
frame = 0;

for (i = 0; i < frame_count; i++)
    ring_image[i] = Image("ring-" + i + ".png");

logo_image = Image("logo.png");

// The mark occupies a bit under a third of the screen's short edge. On a 4:3
// panel that is the same visual weight as on 16:9.
if (screen_width > screen_height)
    mark_size = screen_height * 0.30;
else
    mark_size = screen_width * 0.30;

logo_sprite = Sprite();
logo_sprite.SetX((screen_width  - mark_size) / 2);
logo_sprite.SetY((screen_height - mark_size) / 2);
logo_sprite.SetOpacity(0);

// --- The late rail -----------------------------------------------------------
// Deliberately absent at first. A normal boot never shows it; a slow one gets
// reassurance at the point the user starts to wonder whether it has hung.
rail_delay_ticks = 300;      // refresh runs at ~50 Hz, so roughly 6 seconds
rail_width  = screen_width * 0.16;
rail_height = 3;
rail_x = (screen_width - rail_width) / 2;
rail_y = screen_height * 0.82;

rail_bg = Image.Text("", 1, 1, 1);
progress = 0;
ticks = 0;

fun refresh_callback() {
    ticks++;

    // Fade the mark in over the first ~0.5 s.
    if (ticks < 25)
        logo_sprite.SetOpacity(ticks / 25);
    else
        logo_sprite.SetOpacity(1);

    // Close the ring gap over roughly two and a half seconds, then hold on the
    // last frame rather than looping -- the animation means "coming up", and a
    // loop would turn it back into a meaningless spinner.
    if (ticks < frame_count * 5) {
        frame = ticks / 5;
        if (ring_image[frame])
            logo_sprite.SetImage(ring_image[frame].Scale(mark_size, mark_size));
    } else {
        if (ring_image[frame_count - 1])
            logo_sprite.SetImage(ring_image[frame_count - 1].Scale(mark_size, mark_size));
        else
            logo_sprite.SetImage(logo_image.Scale(mark_size, mark_size));
    }

    // Only now, and only if we are still here, admit that boot is slow.
    if (ticks == rail_delay_ticks) {
        rail_track = Image.Text("", 1, 1, 1).Scale(rail_width, rail_height);
        rail_track_sprite = Sprite(rail_track);
        rail_track_sprite.SetX(rail_x);
        rail_track_sprite.SetY(rail_y);
        rail_track_sprite.SetOpacity(0.18);

        rail_fill_sprite = Sprite();
        rail_fill_sprite.SetX(rail_x);
        rail_fill_sprite.SetY(rail_y);
        rail_fill_sprite.SetOpacity(0.85);
    }

    if (ticks > rail_delay_ticks && rail_fill_sprite) {
        // Indeterminate: a short bar sweeping across, because boot time varies
        // with disk, firmware and pending updates and we cannot honestly
        // promise a percentage.
        sweep = ((ticks - rail_delay_ticks) % 100) / 100;
        bar = Image.Text("", 1, 1, 1).Scale(rail_width * 0.3, rail_height);
        rail_fill_sprite.SetImage(bar);
        rail_fill_sprite.SetX(rail_x + (rail_width * 0.7 * sweep));
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// --- Password prompt ---------------------------------------------------------
// Shown when the disk is encrypted. Without this the machine appears to hang
// at boot with no way to know it is waiting for input.
prompt_sprite = Sprite();
entry_sprite  = Sprite();

fun display_password_callback(prompt, bullets) {
    text = Image.Text(prompt, 0.92, 0.96, 0.95);
    prompt_sprite.SetImage(text);
    prompt_sprite.SetX((screen_width - text.GetWidth()) / 2);
    prompt_sprite.SetY(screen_height * 0.72);

    stars = "";
    for (i = 0; i < bullets; i++)
        stars += "*";
    dots = Image.Text(stars, 0.92, 0.96, 0.95);
    entry_sprite.SetImage(dots);
    entry_sprite.SetX((screen_width - dots.GetWidth()) / 2);
    entry_sprite.SetY(screen_height * 0.77);
}

fun display_normal_callback() {
    prompt_sprite.SetImage(Image.Text("", 0, 0, 0));
    entry_sprite.SetImage(Image.Text("", 0, 0, 0));
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- Shutdown ----------------------------------------------------------------
fun quit_callback() {
    logo_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
