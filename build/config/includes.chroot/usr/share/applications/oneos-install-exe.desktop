[Desktop Entry]
Type=Application
Name=Windows Program
Comment=Install or run a Windows program
Exec=oneos-install-exe %f
Icon=wine
Terminal=false
# NoDisplay: this is a file handler, not something to launch from the menu.
NoDisplay=true
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;application/x-ms-shortcut;
Categories=System;
