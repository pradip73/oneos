# OneOS Phase 1.5 -- interim desktop, Windows and Android support.
#
# WHY THIS FILE EXISTS
# This is deliberately a borrowed desktop, not the OneOS shell. The real shell
# is Phases 2-3 and roughly a year of work; this exists so the OS is usable in
# the meantime and so the Wine and Waydroid layers can be integrated and tested
# now rather than at the end. When the OneOS compositor lands, this list is
# deleted and replaced -- it is scaffolding, not foundation.
#
# WHY KDE PLASMA, specifically
#   - Waydroid REQUIRES a Wayland compositor. That rules out Xfce and LXQt,
#     which are still X11 in practice, however much lighter they are.
#   - Plasma is Qt-based, which matches the Qt/QML shell in ARCHITECTURE.md 2.2.
#     Applications written now survive the transition; a GTK desktop would not.
#   - It is themeable far enough to carry OneOS branding without patching it.
#   - GNOME was rejected: libadwaita deliberately resists theming, and it is
#     heavier than Plasma on the low-memory target.
#
# MEMORY: Plasma idles around 700 MB-1 GB. See README for what that does to the
# 4 GB minimum once Waydroid is also running.

# --- Display manager and session ---------------------------------------------
sddm
plasma-desktop
# NOTE: plasma-workspace-wayland does not exist in Plasma 6 -- the Wayland
# session was merged into plasma-workspace, which plasma-desktop pulls in.
# Asking for the old Plasma 5 package name fails the build outright.
kwin-wayland
systemsettings
plasma-nm
plasma-pa
powerdevil
kscreen

# Xwayland: required by Wine, and by any application without a Wayland backend.
xwayland

# --- Audio -------------------------------------------------------------------
# PipeWire, not PulseAudio. Waydroid and Wine both route through it, and it is
# what ARCHITECTURE.md 2.4 commits to.
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# --- Core applications -------------------------------------------------------
dolphin
konsole
kate
ark
gwenview
okular
firefox-esr
# The Linux side of the three-way demonstration: native VLC, sitting in the
# menu next to the Windows build of the same program. Seeing both run is the
# clearest possible proof of what this OS does.
vlc

# --- App distribution --------------------------------------------------------
# Flatpak for third-party apps, per ARCHITECTURE.md 6.3.
flatpak
plasma-discover
plasma-discover-backend-flatpak
xdg-desktop-portal
xdg-desktop-portal-kde

# --- Windows compatibility ---------------------------------------------------
# 64-bit Wine only in this list. 32-bit Wine needs the i386 architecture
# enabled, which cannot be expressed in a package list -- it is done in
# config/hooks/normal/0020-compat.hook.chroot instead.
#
# NOTE: wine-binfmt is deliberately NOT installed. Registering .exe with
# binfmt_misc makes any downloaded executable one chmod away from running.
# See ARCHITECTURE.md 3.3 point 6.
wine
winetricks
# Vulkan translation for Direct3D. Without these, games and GPU-accelerated
# Windows apps fall back to a software renderer and crawl.
vulkan-tools
mesa-vulkan-drivers
libvulkan1

# --- Android compatibility ---------------------------------------------------
# Waydroid is NOT in the Debian archive. It ships from the Waydroid project's
# own repository, so it is installed in
# config/hooks/normal/0020-compat.hook.chroot where a failure to reach that
# repository degrades to "no Android support" instead of killing the build.
#
# lxc is Waydroid's container runtime and is in Debian, so it can be listed
# here safely.
lxc

# --- File handlers -----------------------------------------------------------
# Required by /usr/bin/oneos-install-exe and oneos-install-apk: kdialog draws
# their prompts, notify-send their notifications, and pkexec authenticates the
# one-time Waydroid setup. Without these the handlers fail silently.
kdialog
libnotify-bin
# pkexec is its own binary package since polkit 122 -- polkitd alone does not
# provide it, and the Waydroid setup in oneos-install-apk needs it to ask for
# the password through the desktop instead of a terminal.
pkexec
desktop-file-utils
shared-mime-info
# Provides xdg-user-dir, which oneos-shortcuts uses to locate the desktop
# folder. That folder's name is localised -- on a Bengali system it is not
# "Desktop" -- so hardcoding the path would put icons somewhere invisible.
xdg-user-dirs

# bubblewrap confines every Windows program -- see /usr/bin/oneos-wine-run.
# Without it, .exe files run with full access to the user's home directory,
# which ARCHITECTURE.md 3.4 treats as unshippable. Listed here rather than
# installed from a hook so a missing package fails the build loudly instead
# of quietly shipping an unprotected image.
bubblewrap

# xdg-open, used by the welcome screen.
xdg-utils

# oneos-about reads the graphics card from lspci and, in oneos-glass.sh, asks
# glxinfo whether rendering is happening on the CPU. Without these the About
# window says "Unknown graphics" and the glass never turns itself off on the
# machines that most need it to.
pciutils
mesa-utils

# unzip unpacks the portable Windows VLC in oneos-demo-windows; curl fetches it
# and the F-Droid APK. Both demos fail with a confusing "download did not
# finish" if these are absent.
unzip
curl

# --- Boot splash and installer -----------------------------------------------
# plymouth draws the boot splash; librsvg2-bin renders the mark from the single
# SVG in the repository at build time, so the artwork has one source of truth
# rather than committed PNGs that drift.
plymouth
plymouth-themes
librsvg2-bin

# Calamares is the graphical installer. calamares-settings-debian supplies a
# tested module configuration; only the branding is overridden, in
# config/hooks/normal/0040-branding.hook.chroot. Writing our own settings.conf
# would mean owning partitioning behaviour, which is where installers destroy
# people's data.
calamares
calamares-settings-debian

# --- Fonts -------------------------------------------------------------------
fonts-noto
fonts-noto-color-emoji
# Bengali, Devanagari and the other Indic scripts. Without this, Bangla renders
# as boxes -- which for this project's audience is not a cosmetic problem.
fonts-noto-core
fonts-indic
